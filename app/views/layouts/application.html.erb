<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Swexe Team05" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Swexe Team05">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% unless controller_name == "admin" %>
      <header class="site-header">
        <div class="header-inner">
          <%= link_to t("site.title"), root_path, class: "site-logo" %>

          <nav class="header-nav">
            <%= link_to t("site.home"), root_path %>
            <%= link_to t("site.spots"), spots_path %>
            <%= link_to t("site.categories"), recommendations_path %>
            <%= link_to t("site.about"), root_path(anchor: "about") %>

            <div class="language-switcher">
              <details>
                <summary>🌐 言語 ▼</summary>
                <div class="language-menu">
                  <%= link_to "日本語", switch_locale_path(:ja) %>
                  <%= link_to "English", switch_locale_path(:en) %>
                </div>
              </details>
            </div>
          </nav>
        </div>
      </header>
    <% end %>

    <%= yield %>
  </body>
</html>