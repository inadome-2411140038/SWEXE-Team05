<div class="spots-page">
  <main class="main-content">

    <section class="spots-section">
      <div class="section-heading">
        <h1>観光スポット一覧</h1>
        <p>広島県内のさまざまな観光スポットを探してみましょう。</p>
      </div>

      <!-- 検索・カテゴリー絞り込み -->
      <%= form_with url: spots_path, method: :get, class: "spot-search-form" do |f| %>
        <div>
          <%= f.label :keyword, "観光地名" %>
          <%= f.text_field :keyword,
              value: params[:keyword],
              placeholder: "観光地名を入力" %>
        </div>

        <div>
          <%= f.label :category_id, "カテゴリー" %>
          <%= f.select :category_id,
              options_from_collection_for_select(
                @categories, :id, :name, params[:category_id]
              ),
              { include_blank: "すべて" } %>
        </div>

        <%= f.submit "検索" %>
      <% end %>

      <!-- 観光スポット一覧 -->
      <div class="spot-list">
        <% if @spots.any? %>
          <% @spots.each do |spot| %>
            <article class="spot-card">
              <% if spot.image.attached? %>
                <%= image_tag spot.image,
                    class: "spot-image",
                    alt: spot.name %>
              <% else %>
                <div class="spot-image-placeholder">
                  <span>画像なし</span>
                </div>
              <% end %>

              <div class="spot-info">
                <h3><%= spot.name %></h3>
                <p class="spot-location">
                  カテゴリー：<%= spot.category.name %>
                </p>
                <p><%= spot.description %></p>
                <%= link_to "詳細を見る →", spot_path(spot) %>
              </div>
            </article>
          <% end %>
        <% else %>
          <p>該当する観光スポットはありません。</p>
        <% end %>
      </div>
    </section>

  </main>
</div>