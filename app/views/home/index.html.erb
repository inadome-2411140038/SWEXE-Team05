<div class="top-page">

  <!-- メインビジュアル -->
  <section class="hero">
    <img src="/images/miyajima.jpg"
         alt="宮島の厳島神社と大鳥居"
         class="hero-image">

    <div class="hero-message">
      <p><%= t("site.hero_title") %></p>
      <h1><%= t("site.hero_description") %></h1>
      <span><%= t("site.hero_subtitle") %></span>
    </div>
  </section>

  <main class="main-content">

    <!-- 検索エリア -->
    <section class="search-section">
      <h2>広島の観光地を探す</h2>
      <p>気になる場所やキーワードから観光地を探してみましょう。</p>

      <%= form_with url: spots_path, method: :get, class: "search-box" do |f| %>
        <%= f.text_field :keyword,
            placeholder: "観光地名・キーワードを入力" %>
        <%= f.submit "検索" %>
      <% end %>
    </section>

    <!-- ジャンルから探す -->
    <section class="category-section" id="categories">
      <div class="section-heading">
        <h2>ジャンルから探す</h2>
        <p>興味のあるジャンルから観光地を見つけよう。</p>
      </div>

      <div class="category-list">
        <% @categories.each do |category| %>
          <%= link_to spots_path(category_id: category.id),
              class: "category-card" do %>
            <span>📍</span>
            <h3><%= category.name %></h3>
            <p><%= category.name %>の観光地を探す</p>
          <% end %>
        <% end %>
      </div>
    </section>

    <!-- おすすめ観光地 -->
    <section class="spots-section" id="spots">
      <div class="section-heading">
        <h2>おすすめ観光地</h2>
        <p>広島県には、まだまだ知られていない魅力がたくさんあります。</p>
      </div>

      <div class="spot-list">
        <% if @spots.any? %>
          <% @spots.each do |spot| %>
            <article class="spot-card">
              <% if spot.image.attached? %>
                <%= image_tag spot.image,
                    class: "spot-image",
                    alt: spot.name %>
              <% else %>
                <div class="spot-image-placeholder">
                  <span>画像なし</span>
                </div>
              <% end %>

              <div class="spot-info">
                <h3><%= spot.name %></h3>
                <p class="spot-location">
                  カテゴリー：<%= spot.category.name %>
                </p>
                <p><%= spot.description %></p>
                <%= link_to "詳細を見る →", spot_path(spot) %>
              </div>
            </article>
          <% end %>
        <% else %>
          <p>現在、おすすめ観光地は登録されていません。</p>
        <% end %>
      </div>

      <div class="more-button">
        <%= link_to "おすすめ観光地をもっと見る →", recommendations_path %>
      </div>
    </section>

    <!-- サイトについて -->
    <section class="about-section" id="about">
      <h2>広島の新しい魅力を発見しよう</h2>
      <p>
        宮島や原爆ドームだけではない、広島県内のさまざまな観光地を紹介しています。
        あなたの知らない広島を見つけてみませんか？
      </p>
    </section>

  </main>

  <!-- フッター -->
  <footer class="site-footer">
    <p>© 2026 ひろしま観光発見！</p>
  </footer>

</div>
