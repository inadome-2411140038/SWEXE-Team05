<h1>観光スポットの編集</h1>

<p><%= notice %></p>

<% if @spot.errors.any? %>
  <ul>
    <% @spot.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @spot, url: admin_update_path(@spot.id), method: :patch do |f| %>
  <div>
    <%= f.label :name, "スポット名" %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :name_kana, "スポット名（ひらがな）" %>
    <%= f.text_field :name_kana %>
  </div>

  <div>
    <%= f.label :description, "説明" %>
    <%= f.text_area :description %>
  </div>

  <div>
    <%= f.label :category_id, "カテゴリ" %>
    <%= f.collection_select :category_id, @categories, :id, :name, { prompt: "カテゴリを選択してください" } %>
  </div>

  <div>
    <%= f.check_box :recommended %>
    <%= f.label :recommended, "おすすめ観光地にする" %>
  </div>

  <div>
    <%= f.label :image, "画像" %>

    <% if @spot.image.attached? %>
      <p>現在の画像</p>
      <%= image_tag @spot.image, width: 200 %>
    <% end %>

    <%= f.file_field :image, accept: "image/*" %>
  </div>

  <div>
    <%= f.submit "更新する" %>
  </div>
<% end %>

<% if @spot.image.attached? %>
  <hr>

  <%= button_to "現在の画像を削除",
      admin_delete_image_path(@spot.id),
      method: :delete,
      form: { data: { turbo_confirm: "画像を削除しますか？" } } %>
<% end %>

<p><%= link_to "観光スポット管理に戻る", admin_spots_path %></p>